---
interface Props {
  class?: string;
}
const { class: className = 'w-5 h-5' } = Astro.props;
---
<!--
  Fade & Trim monogram: scissors + comb crossed in an X with an
  italic ampersand sitting below. Adapted from the shop's signage.
  Uses currentColor — set the colour on the parent.
-->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 72"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <!-- Scissors: handles bottom-left, blades top-right -->
  <circle cx="11" cy="48" r="3.6" />
  <circle cx="18" cy="53" r="3.6" />
  <line x1="14" y1="45" x2="50" y2="11" />
  <line x1="21" y1="50" x2="56" y2="16" />

  <!-- Comb: spine top-left to bottom-right, perpendicular to scissors -->
  <line x1="9" y1="13" x2="51" y2="55" />
  <!-- Comb teeth (short ticks on the lower-left side of the spine) -->
  <line x1="14" y1="18" x2="11" y2="21" />
  <line x1="19" y1="23" x2="16" y2="26" />
  <line x1="24" y1="28" x2="21" y2="31" />
  <line x1="29" y1="33" x2="26" y2="36" />
  <line x1="34" y1="38" x2="31" y2="41" />
  <line x1="39" y1="43" x2="36" y2="46" />
  <line x1="44" y1="48" x2="41" y2="51" />

  <!-- Ampersand sitting below the crossing -->
  <text
    x="32"
    y="69"
    text-anchor="middle"
    font-family="Georgia, 'Playfair Display', serif"
    font-style="italic"
    font-size="13"
    font-weight="600"
    stroke="none"
    fill="currentColor"
  >&amp;</text>
</svg>
